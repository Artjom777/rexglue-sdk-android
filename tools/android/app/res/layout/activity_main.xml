<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- App Header: Exactly as in screenshot -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ReXGlue Studio"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Xbox 360 Porting Toolkit"
            android:textColor="#7A7D88"
            android:textSize="15sp" />

        <!-- Card 1: Настройка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройка"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Primary ISO (Disc 1) Pill Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_xex_path"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Путь к игре (Диск 1)..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#686C7B"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_browse_xex"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="📁 Обзор"
                    android:textColor="#0F1C3A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- Dynamic Container for Extra ISO Discs -->
            <LinearLayout
                android:id="@+id/container_extra_isos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Button: Add Extra Disc (+) -->
            <LinearLayout
                android:id="@+id/btn_add_iso"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_add"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="#ADC6FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Добавить ISO диск / часть"
                    android:textColor="#ADC6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Title Update Input Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_pill"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="15sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_update_path"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Title Update / Патч (опц)..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#686C7B"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btn_browse_update"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_button"
                    android:text="📁 Обзор"
                    android:textColor="#0F1C3A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- Project Name Field (underline style from screenshot) -->
            <EditText
                android:id="@+id/et_project_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="xbox360_port"
                android:textColor="#FFFFFF"
                android:textColorHint="#686C7B"
                android:textSize="14sp"
                android:paddingBottom="6dp"
                android:background="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2C303C" />
        </LinearLayout>

        <!-- Card 2: Режим -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Режим"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Pill 1: Монтирование ISO -->
                <LinearLayout
                    android:id="@+id/btn_mode_iso"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_selected"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_mode_iso_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔘"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_mode_iso_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Монтирование ISO"
                        android:textColor="#0F1C3A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Pill 2: Standalone APK -->
                <LinearLayout
                    android:id="@+id/btn_mode_standalone"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_unselected"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_mode_standalone_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_mode_standalone_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standalone APK"
                        android:textColor="#838898"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Оптимизация -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Оптимизация"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cb_mali_vk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mali Vulkan"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#ADC6FF" />

            <CheckBox
                android:id="@+id/cb_page_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="16KB Alignment"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#ADC6FF" />

            <CheckBox
                android:id="@+id/cb_big_cores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Cortex Affinity"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#ADC6FF" />
        </LinearLayout>

        <!-- Big Action Buttons (exact 1:1 colors and shapes from screenshot) -->
        <!-- 1. Декомпиляция -->
        <Button
            android:id="@+id/btn_codegen"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_blue"
            android:text="Декомпиляция"
            android:textColor="#0F1C3A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 2. Собрать APK -->
        <Button
            android:id="@+id/btn_build_port_apk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_purple"
            android:text="Собрать APK"
            android:textColor="#280D46"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 3. Запустить игру -->
        <Button
            android:id="@+id/btn_launch"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_green"
            android:text="Запустить игру"
            android:textColor="#0C3612"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="#ADC6FF"
            android:visibility="gone" />

        <!-- Section: Логи -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Логи"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scroll_console"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_console"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Подключение успешно\nСборка готова к запуску..."
                android:textColor="#7C808F"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
